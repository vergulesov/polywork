[Unit]
Description=PolyWork HH RSS valve and pipeline-equipment sales -> Запорная арматура
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/polywork
EnvironmentFile=/opt/polywork/.env
ExecStart=/opt/polywork/.venv/bin/python -u /opt/polywork/collector_valves.py --days 14 --pages 5 --write
TimeoutStartSec=900
