[Unit]
Description=Sales vacancies RSS -> dedicated Google Sheets RAW
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/polywork
EnvironmentFile=/opt/polywork/sales-rss.env
ExecStart=/opt/polywork/.venv/bin/python -u /opt/polywork/sales_vacancies.py --days 3 --pages 8 --write --raw-only
TimeoutStartSec=900
