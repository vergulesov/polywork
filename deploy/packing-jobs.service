[Unit]
Description=PolyWork HH RSS packing and low-contact jobs -> Фасовка
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/polywork
EnvironmentFile=/opt/polywork/.env
ExecStart=/opt/polywork/.venv/bin/python -u /opt/polywork/collector_packing.py --days 14 --pages 5 --write
TimeoutStartSec=900
